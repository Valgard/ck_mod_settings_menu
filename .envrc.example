#!/usr/bin/env bash
# ModSettingsMenu — environment variables.
#
# Machine-level shared values (UNITY_BIN, SDK_PATH, CK_GAME_VERSION,
# MODIO_DEPS_MAP, LOC_TABLE, the ilspycmd PATH entry) are inherited from the
# parent core_keeper/.envrc — define them once there, not here.
#
#   cp .envrc.example .envrc
#   direnv allow                     # then `cd` triggers the chain
#   # or, without direnv:  source .envrc && ../utils/build.sh

# --- Inherit shared values from the parent core_keeper/.envrc ---------------
if command -v source_up_if_exists >/dev/null 2>&1; then
    source_up_if_exists          # direnv: walk up to core_keeper/.envrc
elif [ -f ../.envrc ]; then
    source ../.envrc             # manual `source .envrc` fallback
fi

# --- Mod identity (project-inherent — leave as-is) --------------------------

# PascalCase name — drives SDK symlink paths and the build entry point.
export MOD_NAME="ModSettingsMenu"

# kebab-case id, written as `name_id` in the fake mod.io state.json.
export MOD_NAME_ID="mod-settings-menu"

# One-line summary, written into state.json by utils/install-macos.sh.
export MOD_SUMMARY="A shared in-game Options-menu screen where other mods register their settings."

# Fake mod.io ID — must be DISTINCT per mod.
export FAKE_MOD_ID="9999991"

# ModBuilder output staging dir (build.sh → install-macos.sh copies onward).
# MOD_INSTALL_BASE_PATH is inherited from the parent core_keeper/.envrc above.
export MOD_INSTALL_PATH="$MOD_INSTALL_BASE_PATH/$MOD_NAME_ID-build"

# Repo root, read by the shared CLIPublishHelper to locate CHANGELOG.md.
export MOD_REPO_ROOT="$PWD"

# mod.io "Type" tags for the listing — PIPE-separated, because the values
# contain spaces. Synchronised (not just added) by the shared
# CLIPublishHelper, so a value dropped here is removed on mod.io. Valid:
# Visual, Audio, Item, NPC, Quality of Life, Overhaul, Language, World,
# Library, Other.
export CK_MODIO_TYPE="Visual|Library|Quality of Life"

# --- Localisation (read by utils/CLIBuildHelper.cs -> LocalizationGenerator.GenerateFromEnv) ---
# LOC_YAML lives OUTSIDE unity/ so the ModBuilder doesn't pack the source yaml.
# LOC_TABLE is the shared CK language-address table, inherited from the parent.
export LOC_YAML="$PWD/localization/localization.yaml"
export LOC_OUT="$PWD/unity/$MOD_NAME/Localization/Generated"

# --- Dev-only build flags (read by utils/CLIBuildHelper.cs -> DevFlags.generated.cs) ---
# Comma-separated flag names, checked at runtime via DevFlags.Is("<name>"). Regenerated on
# EVERY build, so leaving this unset (the default — do NOT export it here) always restores the
# safe "everything off" state, even if a previous build was run with a flag on. Uncomment only
# for a single local build session while iterating, e.g.:
#   MOD_DEV_FLAGS=TestFixtures ../utils/build.sh
# "TestFixtures" enables ModSettingsMenuMod.EarlyInit's four disposable foreign-config list rows
# (Short/Long/LongReadOnly/ShortRestart) for exercising the list-widget drill-in without a real
# foreign mod installed.
# export MOD_DEV_FLAGS="TestFixtures"
